{
  "name": "uidev1116/acms-wxr-import",
  "description": "WordPress のデータを a-blog cms にインポートするためのプラグイン（拡張アプリ）です。",
  "scripts": {
    "lint": [
      "vendor/bin/phpcs --standard=phpcs.xml || true"
